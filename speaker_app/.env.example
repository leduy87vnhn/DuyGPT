# DuyGPT server on the main machine.
# Use the LAN IP address of the DuyGPT machine, not 127.0.0.1 from the Pi.
DUYGPT_URL=http://192.168.1.10:8383

# Copy this from the DuyGPT server .env:
# DEVICE_API_KEY=<secret>
DEVICE_API_KEY=

# Recommended for Raspberry Pi Zero 2W: let the DuyGPT server run Whisper.
# Use "local" only after installing and configuring Vosk on the Pi.
STT_MODE=server

# Hotword and recording behavior.
HOTWORD_PHRASES=loa oi,alo loa oi
HOTWORD_CHUNK_SECONDS=2
QUESTION_SECONDS=7
WAKE_POLL_SECONDS=0.2

# ALSA devices. Start with "default"; change after checking arecord -l / aplay -l.
CAPTURE_DEVICE=default
PLAYBACK_DEVICE=default
AUDIO_RATE=16000
AUDIO_CHANNELS=1

# Text-to-speech.
# espeak = offline and light, edge = nicer voice but needs internet and mpg123.
TTS_MODE=espeak
ESPEAK_VOICE=vi
ESPEAK_SPEED=150
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural

# Spoken status messages.
READY_REPLY=Có đây
UNCLEAR_REPLY=Mình chưa nghe rõ, con nói lại nhé.
ERROR_REPLY=Mình đang gặp lỗi kết nối, thử lại sau nhé.

# Optional. Leave empty to create a fresh session id at each app start.
SESSION_ID=

# Local Vosk mode only.
VOSK_MODEL_PATH=
SERVER_TIMEOUT_SECONDS=120
