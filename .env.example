HOST=0.0.0.0
PORT=8383

# ollama or openai
PROVIDER=ollama

# Set this to one of your installed models, for example from `ollama list`.
MODEL=qwen2.5:32b-instruct-q4_K_M

OLLAMA_URL=http://127.0.0.1:11434

# For llama.cpp server, vLLM, LM Studio, text-generation-webui, etc.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=

TEMPERATURE=0.7
OLLAMA_NUM_CTX=4096
MAX_TOKENS=
# Hybrid-reasoning models (Qwen3...) generate a hidden "thinking" pass before
# the real answer by default -- this multiplies badly with tool-calling loops
# (/home, /work, /crm can call the model several times per turn). Off by
# default for speed; tested against a real multi-constraint business reasoning
# prompt with no measurable quality loss. Set to 1 to trade speed for
# potentially deeper reasoning. This is just the system-wide fallback -- any
# user can override it live per module (or overall, in Cài Đặt Chung) from the
# web UI without a restart; see /settings and each module's "Cài đặt" tab.
OLLAMA_THINK=0

# Public deployment controls
# Set REQUIRE_LOGIN=1 before exposing the service to the Internet.
REQUIRE_LOGIN=0
DISABLE_REGISTRATION=0
# Optional shared key for devices calling voice/API endpoints with X-Device-Key.
DEVICE_API_KEY=
# Server-side TTS (POST /api/voice/speak, or /api/voice/assistant with
# "want_audio": true) via edge-tts. Needs internet (calls Microsoft's Edge TTS
# service) -- Raspberry Pi speakers are expected to do TTS locally instead
# (see docs/raspberry-pi-speaker.md); this is for clients that can't.
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
# Optional CORS origin, for example https://chat.example.com. Empty = same-origin only.
CORS_ORIGIN=

# Image generation. Keep disabled until an image backend is installed/configured.
# Supported providers: disabled, openai, sdwebui, comfyui.
# The DuyGPT UI/API stays on PORT. If you run a local image backend separately,
# port 8384 is a good choice; set SDWEBUI_URL or COMFYUI_URL to that service.
IMAGE_PROVIDER=disabled
IMAGE_PROMPT_REFINE=1
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium

# OpenAI image API
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Stable Diffusion WebUI / AUTOMATIC1111. Start WebUI with --api.
SDWEBUI_URL=http://127.0.0.1:7860
SDWEBUI_WIDTH=512
SDWEBUI_HEIGHT=512
SDWEBUI_STEPS=4
SDWEBUI_CFG_SCALE=0
SDWEBUI_SAMPLER=DPM++ 2M
SDWEBUI_NEGATIVE_PROMPT=blurry, low quality, distorted, deformed, bad anatomy, watermark, logo, random text

# ComfyUI. Export a workflow with "Export (API)" and set the node ids.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_FILE=
COMFYUI_PROMPT_NODE_ID=
COMFYUI_NEGATIVE_PROMPT_NODE_ID=
COMFYUI_SEED_NODE_ID=
COMFYUI_NEGATIVE_PROMPT=
COMFYUI_POLL_ATTEMPTS=240

# PostgreSQL connection (users, chat history, RAG documents)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=duygpt
PGUSER=duygpt
PGPASSWORD=

# Fixed, unique admin account. Nobody can self-register as admin_user.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=abcd@123

# How long a login session stays valid
SESSION_TTL_DAYS=30

# Max stored messages kept per conversation (older ones are pruned)
CHAT_HISTORY_LIMIT=50
# Apply the admin-edited persona/system prompt to normal web chat too.
CHAT_PERSONA_ENABLED=1
# Per-user long-term memory. Applies only to logged-in users.
USER_MEMORY_ENABLED=1
USER_MEMORY_LIMIT=12
USER_MEMORY_EXTRACT_LIMIT=5

# RAG: embedding model served by Ollama, and how many chunks to retrieve per chat turn
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
RAG_TOP_K=4
MAX_UPLOAD_MB=20

# Voice pipeline (Raspberry Pi edge devices): speech recognition + chat persona
# faster-whisper model size/device/compute_type. "auto" picks GPU if available.
STT_MODEL=small
STT_DEVICE=auto
STT_COMPUTE_TYPE=default
# Force a transcription language (faster, more accurate for known language). Empty = auto-detect.
STT_LANGUAGE=vi

# Username of the single internal account that owns the continuous voice conversation history
VOICE_DEVICE_USERNAME=voice-assistant
# How many recent voice messages to feed back into the model as conversation memory
VOICE_CONTEXT_MESSAGES=10

# Default persona/system prompt seeded once into the DB on first startup.
# After that, edit it live via PUT /api/admin/persona (admin only).
DEFAULT_PERSONA_PROMPT=

# Family home assistant module (ben_homeassistant): reminders, notes, shopping
# list agent with tool-calling. Reuses the same LLM (PROVIDER/MODEL above) and
# the same Postgres database as the rest of DuyGPT. Web UI at /home.
HOME_ASSISTANT_ENABLED=1
# Leave empty to reuse MODEL. Set to a smaller/faster tool-calling model if you
# want the family assistant to respond quicker than the main chat model.
HOME_ASSISTANT_MODEL=
# Max tool-call round trips per user message before forcing a plain-text reply.
HOME_ASSISTANT_MAX_TOOL_ITERATIONS=6
# How many past messages of a home-assistant conversation to feed back as context.
HOME_ASSISTANT_CONTEXT_MESSAGES=20
# Optional override for the family assistant's system prompt.
HOME_ASSISTANT_SYSTEM_PROMPT=

# Customer requirement management module (CRM), admin-only. Reuses the same
# LLM (PROVIDER/MODEL above), the same Postgres database, and the same RAG
# embedding setup (EMBEDDING_MODEL/EMBEDDING_DIM above) as the rest of DuyGPT.
# Web UI at /crm.
CRM_MODEL=
CRM_MAX_TOOL_ITERATIONS=6
CRM_CONTEXT_MESSAGES=20
